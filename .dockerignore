# Arquivos e diretórios a ignorar no Docker build
# ================================================
# Otimizado para HFT: reduzir tamanho da imagem e build time

# Segredos e configurações sensíveis
config/settings.py
config/secrets/
.env*
!.env.example

# Dados locais (montados como volumes)
data/
logs/

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Git
.git
.gitignore
.gitattributes
README.md
docs/

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testes e desenvolvimento
tests/
.coverage
.pytest_cache/
.tox/
.cache
*.log

# Docker (evita recursão infinita)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
deploy/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Monitoring (gerado dinamicamente)
monitoring/

# Backups e temporários
*.bak
*.backup
*.old
*.tmp
temp/
Thumbs.db
