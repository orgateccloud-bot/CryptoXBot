# Arquivo de exemplo para variáveis de produção
# Copie para .env.prod e preencha com valores reais

# Ambiente
ENV=production
GCP_PROJECT_ID=rich-streamer-v4p9v

# API Keys (serão buscadas do Secret Manager em produção)
# BINANCE_API_KEY=your-api-key-here
# BINANCE_API_SECRET=your-api-secret-here

# Configurações opcionais
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO

# Redis (interno ao Docker)
REDIS_URL=redis://redis:6379

# Dry run (sempre false em produção)
DRY_RUN=false