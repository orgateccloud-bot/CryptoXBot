{
    "dashboard": {
        "id": null,
        "title": "BotBinance HFT - Performance Monitoring",
        "tags": [
            "botbinance",
            "hft",
            "trading"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "Tick Processing Latency",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(botbinance_tick_processing_latency_seconds_bucket[5m]))",
                        "legendFormat": "95th percentile",
                        "refId": "A"
                    },
                    {
                        "expr": "histogram_quantile(0.50, rate(botbinance_tick_processing_latency_seconds_bucket[5m]))",
                        "legendFormat": "50th percentile",
                        "refId": "B"
                    }
                ],
                "thresholds": [
                    {
                        "value": 0.05,
                        "colorMode": "critical",
                        "op": "gt",
                        "fill": true,
                        "line": true,
                        "fillColor": "red"
                    }
                ],
                "yAxes": [
                    {
                        "unit": "seconds",
                        "min": 0
                    },
                    {
                        "unit": "short"
                    }
                ],
                "alert": {
                    "conditions": [
                        {
                            "evaluator": {
                                "params": [
                                    0.05
                                ],
                                "type": "gt"
                            },
                            "operator": {
                                "type": "and"
                            },
                            "query": {
                                "params": [
                                    "A",
                                    "5m",
                                    "now"
                                ]
                            },
                            "reducer": {
                                "params": [],
                                "type": "avg"
                            },
                            "type": "query"
                        }
                    ],
                    "executionErrorState": "alerting",
                    "frequency": "60s",
                    "handler": 1,
                    "name": "High Tick Latency Alert",
                    "noDataState": "no_value",
                    "notifications": []
                }
            },
            {
                "id": 2,
                "title": "CVD Calculation Time",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(botbinance_cvd_calculation_time_seconds_bucket[5m]))",
                        "legendFormat": "95th percentile",
                        "refId": "A"
                    },
                    {
                        "expr": "histogram_quantile(0.50, rate(botbinance_cvd_calculation_time_seconds_bucket[5m]))",
                        "legendFormat": "50th percentile",
                        "refId": "B"
                    }
                ],
                "yAxes": [
                    {
                        "unit": "seconds",
                        "min": 0
                    },
                    {
                        "unit": "short"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Memory Usage",
                "type": "graph",
                "targets": [
                    {
                        "expr": "botbinance_memory_usage_bytes",
                        "legendFormat": "Memory Usage",
                        "refId": "A"
                    }
                ],
                "yAxes": [
                    {
                        "unit": "bytes",
                        "min": 0
                    },
                    {
                        "unit": "short"
                    }
                ]
            }
        ],
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "timepicker": {},
        "templating": {
            "list": []
        },
        "annotations": {
            "list": []
        },
        "refresh": "5s",
        "schemaVersion": 16,
        "version": 0,
        "links": []
    }
}