# Chaves de API — NUNCA versionar
config/settings.py

# Banco de dados e artefatos locais
# NOTA: o codigo-fonte em data/ (cvd_calculator.py, stream_processor.py, __init__.py)
# E versionado. Apenas os artefatos de runtime abaixo sao ignorados.
data/*.db
# Backups automaticos de scripts de migracao (purgar_fixtures_producao.py,
# normalizar_timestamps.py). `data/*.db` nao os cobria porque o sufixo vem
# DEPOIS da extensao: data/btc_data.db.bkp-ts-20260808-093743.
*.db.bkp-*
data/*.db.bkp*
# WAL/SHM do SQLite (o sufixo vem depois de .db, entao *.db nao cobre)
*.db-shm
*.db-wal
data/*.sqlite
data/*.sqlite3
data/*.csv
data/*.json
# E-9/I-12g: o historico de Fear & Greed E versionado. Sem ele nao existe
# medicao valida para o gate (a producao aplica o veto de sentimento; o
# backtest sem o arquivo rodava com neutro fixo). Sao ~100 KB de dado
# publico, e versiona-los e o que torna a medicao reproduzivel num clone
# limpo -- mesmo criterio de I-11.
!data/fng_historico.json
!data/fng_historico.manifest.json
data/__pycache__/

# I-11: o snapshot de pesquisa e VERSIONADO de proposito. Sem ele no git,
# nenhum veredito e re-derivavel em outra maquina — que e todo o ponto.
# ~2,9 MB, imutavel; um snapshot novo vai para outro diretorio.
!data/snapshots/
!data/snapshots/**
*.db

