# BinanceXBot — Variáveis de Ambiente
# =====================================
# Copie para .env e configure. NUNCA commitar .env com valores reais.
# Em produção: .env fica em /opt/binancexbot/.env no servidor (fora do Git).

# ── Binance API ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Endpoints (padrão: Binance SPOT — sinal e execução no MESMO mercado)
# Futures exige adaptar o executor (/fapi/v1) — não basta trocar a URL.
REST_BASE_URL=https://api.binance.com
WS_BASE_URL=wss://stream.binance.com:9443

# ── Segurança de Trading ──────────────────────────────────────────────────────
# DRY_RUN=true garante paper trading mesmo com chaves reais configuradas.
# Para ordens reais: DRY_RUN=false + ALLOW_REAL_TRADING=true + ENV=production.
DRY_RUN=true
ALLOW_REAL_TRADING=false

# ── Execução maker-first (P0-2) ───────────────────────────────────────────────
# Entradas via LIMIT_MAKER (post-only) no melhor bid — sempre fee de maker, sem
# cruzar o spread. Re-quota se não preencher. MAKER_FIRST=false volta ao LIMIT
# cruzando (taker, garante fill imediato).
MAKER_FIRST=true
MAKER_TIMEOUT_S=20      # segundos aguardando fill antes de re-quotar
MAKER_MAX_REQUOTES=3    # re-quotes antes de desistir da entrada

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Dev local: deixar vazio → SQLite em data/btc_data.db
DATABASE_BACKEND=sqlite
DATABASE_URL=

# Produção (Supabase):
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_POOL_MIN=1
DB_POOL_MAX=5

# ── Telegram Alertas ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Servidor Web ──────────────────────────────────────────────────────────────
# Worker: PORT=8080 + ENABLE_HEALTH_SERVER=true → expõe /health /ready /metrics
# Dashboard: PORT=5000 → Flask escuta nessa porta
PORT=5000
SECRET_KEY=botbinance-local-dev-change-in-prod

# Restringir CORS em produção:
# CORS_ORIGINS=https://seu-dominio.com
CORS_ORIGINS=*

# ── Segurança do Dashboard (P0-5) ─────────────────────────────────────────────
# Padrão: dashboard só responde em 127.0.0.1 (localhost). Para expor na rede:
# DASHBOARD_BIND=0.0.0.0
# DASHBOARD_TOKEN=<gere com: python -c "import secrets; print(secrets.token_urlsafe(32))">
# Com DASHBOARD_TOKEN setado, /api/* exige "Authorization: Bearer <token>" ou ?token=

# Papel do processo (worker | dashboard) — injetado pelo docker-compose/systemd
SERVICE_ROLE=worker

# Health server para o worker
# ENABLE_HEALTH_SERVER=true

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development | production
ENV=development
# APP_ENV=development  # alias, mesma var

# ── Configuração do Bot ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
SYMBOL=BTCUSDT
MIN_BTC_VOLUME=0.5
WHALE_BTC_VOLUME=5.0
