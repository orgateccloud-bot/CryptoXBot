# BinanceXBot — Variáveis de Ambiente
# =====================================
# Copie para .env e configure. NUNCA commitar .env com valores reais.
# Em produção: .env fica em /opt/binancexbot/.env no servidor (fora do Git).

# ── Binance API ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Endpoints (padrão: Binance Futures)
REST_BASE_URL=https://fapi.binance.com
WS_BASE_URL=wss://fstream.binance.com

# ── Segurança de Trading ──────────────────────────────────────────────────────
# DRY_RUN=true garante paper trading mesmo com chaves reais configuradas.
# Para ordens reais: DRY_RUN=false + ALLOW_REAL_TRADING=true + ENV=production.
DRY_RUN=true
ALLOW_REAL_TRADING=false

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Dev local: deixar vazio → SQLite em data/btc_data.db
DATABASE_BACKEND=sqlite
DATABASE_URL=

# Produção (Supabase):
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_POOL_MIN=1
DB_POOL_MAX=5

# ── Telegram Alertas ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Servidor Web ──────────────────────────────────────────────────────────────
# Worker: PORT=8080 + ENABLE_HEALTH_SERVER=true → expõe /health /ready /metrics
# Dashboard: PORT=5000 → Flask escuta nessa porta
PORT=5000
SECRET_KEY=botbinance-local-dev-change-in-prod

# Restringir CORS em produção:
# CORS_ORIGINS=https://seu-dominio.com
CORS_ORIGINS=*

# Papel do processo (worker | dashboard) — injetado pelo docker-compose/systemd
SERVICE_ROLE=worker

# Health server para o worker
# ENABLE_HEALTH_SERVER=true

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development | production
ENV=development
# APP_ENV=development  # alias, mesma var

# ── Configuração do Bot ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
SYMBOL=BTCUSDT
MIN_BTC_VOLUME=0.5
WHALE_BTC_VOLUME=5.0
