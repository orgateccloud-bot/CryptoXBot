# BinanceXBot — Variáveis de Ambiente
# =====================================
# Copie para .env e configure. NUNCA commitar .env com valores reais.
# Em produção (Railway), configure via painel de variáveis do serviço.

# ── Binance API ───────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Segurança de Trading ──────────────────────────────────────────
# DRY_RUN=true garante paper trading mesmo com chaves reais configuradas
DRY_RUN=true
# ALLOW_REAL_TRADING=true só habilita ordens reais quando explicitamente pedido
ALLOW_REAL_TRADING=false

# ── Banco de Dados ────────────────────────────────────────────────
# Para desenvolvimento local: deixar em branco → usa SQLite (data/btc_data.db)
DATABASE_BACKEND=sqlite
DATABASE_URL=

# Para Railway + Supabase: preencher com a connection string do Supabase
# Supabase → Settings → Database → Connection string (Transaction pooler ou Direct)
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Telegram Alertas ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Servidor Web / Railway ────────────────────────────────────────
# PORT é injetado automaticamente pelo Railway. Não definir manualmente em produção.
# PORT=5000
SECRET_KEY=botbinance-local-dev-change-in-prod
CORS_ORIGINS=*

# Serviço Railway: 'worker' (main.py) ou 'dashboard' (dashboard.py)
# SERVICE_ROLE é lido de RAILWAY_SERVICE_NAME automaticamente se não definido.
# SERVICE_ROLE=worker

# Health server para o worker: Railway injeta PORT → ativado automaticamente
# ENABLE_HEALTH_SERVER=true

# ── Configuração do Bot ───────────────────────────────────────────
LOG_LEVEL=INFO
SYMBOL=BTCUSDT
MIN_BTC_VOLUME=0.5
WHALE_BTC_VOLUME=5.0

# ── Pool de Conexões Postgres ─────────────────────────────────────
DB_POOL_MIN=1
DB_POOL_MAX=5
