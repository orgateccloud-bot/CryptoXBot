# BotBinance Environment Configuration
# ===================================
# Arquivo de exemplo para variáveis de ambiente
# Copie para .env e configure suas chaves API

# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Application Configuration
LOG_LEVEL=INFO
PYTHONPATH=/app

# Paper Trading Mode (Safety First!)
DRY_RUN=true

# Redis Configuration (opcional)
REDIS_URL=redis://redis:6379/0

# Database Configuration (se usar PostgreSQL)
DATABASE_URL=postgresql://botuser:password@postgres/botbinance

# Monitoring
GRAFANA_PASSWORD=secure_password_here
POSTGRES_PASSWORD=secure_db_password_here

# Docker Configuration
COMPOSE_PROJECT_NAME=botbinance
DOCKER_BUILDKIT=1